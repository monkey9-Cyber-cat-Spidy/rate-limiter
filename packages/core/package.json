{
  "name": "@manikanta/rate-limiter",
  "version": "1.0.0",
  "description": "Production-ready Distributed Rate Limiter library supporting Token Bucket, Sliding Window, Fixed Window, and Leaky Bucket algorithms.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./algorithms/*": {
      "import": "./dist/algorithms/*.js",
      "types": "./dist/algorithms/*.d.ts"
    },
    "./store/*": {
      "import": "./dist/store/*.js",
      "types": "./dist/store/*.d.ts"
    },
    "./middleware/*": {
      "import": "./dist/middleware/*.js",
      "types": "./dist/middleware/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "rate-limiter",
    "redis",
    "token-bucket",
    "sliding-window",
    "fixed-window",
    "leaky-bucket",
    "express"
  ],
  "author": "Manikanta",
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "ioredis": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "ioredis-mock": "^8.9.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
